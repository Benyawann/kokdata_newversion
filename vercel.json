{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "pip_install": "Flask==3.0.0 psycopg2-binary==2.9.9 python-dotenv==1.0.0 gunicorn==21.2.0"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}